{
	"name": "smartplant",
	"version": "3.0.0",
	"description": "A bridge between AI and plants: pluggable sensors, persistent plant memory, multi-provider AI and a first-person plant voice.",
	"main": "src/index.js",
	"module": "src/index.js",
	"exports": {
		".": "./src/index.js",
		"./sensors": "./src/sensors/registry.js",
		"./sensors/serial": "./src/sensors/drivers/serial.js",
		"./sensors/mqtt": "./src/sensors/drivers/mqtt.js",
		"./sensors/electrode": "./src/sensors/drivers/electrode.js",
		"./memory": "./src/memory/store.js",
		"./voice": "./src/voice/persona.js",
		"./plugin": "./src/plugin.js",
		"./signals": "./src/signals/index.js",
		"./vision": "./src/vision/index.js",
		"./knowledge": "./src/knowledge/index.js",
		"./integrations": "./src/integrations/index.js",
		"./firmware": "./src/firmware/index.js",
		"./federated": "./src/federated/index.js",
		"./bridge.py": "./src/vision/bridge.py",
		"./package.json": "./package.json",
		"./fusion": "./src/fusion/index.js",
		"./control": "./src/control/index.js",
		"./safety": "./src/safety/index.js",
		"./confidence": "./src/confidence/index.js",
		"./personalization": "./src/personalization/index.js",
		"./hardware": "./src/hardware/index.js",
		"./integrations/openclaw": "./src/integrations/openclaw.js"
	},
	"bin": {
		"smartplant": "src/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"chalk": "5.6.2",
		"enquirer": "2.4.1"
	},
	"peerDependencies": {
		"@serialport/parser-readline": "^13.0.0",
		"mqtt": "^5.0.0",
		"serialport": "^13.0.0"
	},
	"peerDependenciesMeta": {
		"serialport": {
			"optional": true
		},
		"@serialport/parser-readline": {
			"optional": true
		},
		"mqtt": {
			"optional": true
		}
	},
	"keywords": [
		"plant",
		"care",
		"alerts",
		"multi-language",
		"smart",
		"AI",
		"LLM",
		"iot",
		"sensors",
		"mqtt",
		"home-assistant",
		"intelligence",
		"npm",
		"library"
	],
	"author": "Alejo Malia <alejomalia@gmail.com>",
	"files": [
		"./src"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"homepage": "https://github.com/pigeonposse/smartplant",
	"repository": {
		"type": "git",
		"url": "https://github.com/pigeonposse/smartplant"
	},
	"funding": {
		"type": "individual",
		"url": "https://pigeonposse.com/?popup=donate"
	},
	"bugs": {
		"url": "https://github.com/pigeonposse/smartplant/issues",
		"email": "dev@pigeonposse.com"
	},
	"scripts": {
		"dev": "node src/cli.js",
		"start": "node src/cli.js",
		"test": "node --test test/*.test.js"
	},
	"license": "MIT"
}
